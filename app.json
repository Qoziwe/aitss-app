{
  "expo": {
    "name": "AITSS",
    "slug": "aitss",
    "scheme": "aitss",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "tsconfigPaths": true,
      "baseUrl": "/aitss-app"
    }
  }
}
